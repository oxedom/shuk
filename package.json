{
  "name": "shuk",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "pnpm exec playwright test",
    "test:hdls": "pnpm exec playwright test",
    "local:ci": "gh act",
    "report": "pnpm exec playwright show-report",
    "prte": "pnpm prettier --write .",
    "dev": "NODE_ENV=development next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "backup": "./scripts/backup-db.sh",
    "sync:staging": "node ./scripts/syncStagingToDev.js",
    "sync:prod": "node ./scripts/syncWithProd.js",
    "migrate:temp": "npx sequelize-cli migration:generate --name && echo \"\\n\\n✅ Naming Convention Rule (Filename)\\nYYYYMMDDHHMMSS-action-target-details.js\\nWhere:\\n\\nYYYYMMDDHHMMSS = timestamp (auto-added by Sequelize)\\n\\naction = one of:\\n\\ncreate – for new tables\\nadd – for new columns or constraints\\nremove – for dropping columns or constraints\\nrename – for renaming things\\nchange – for type or constraint changes\\nrevert – for undoing previous migrations\\n\\ntarget = main subject (e.g. users, program-plan-workouts)\\n\\ndetails = what's being changed (e.g. add-role-column, change-email-type)\\n\\n\"",
    "psql:dev": "node scripts/psql.js development",
    "psql:prod": "node scripts/psql.js production",
    "psql:staging": "node scripts/psql.js staging",
    "migrate:up:dev": "NODE_ENV=development npx sequelize-cli db:migrate",
    "migrate:up:prod": "NODE_ENV=production npx sequelize-cli db:migrate",
    "migrate:undo:dev": "NODE_ENV=development npx sequelize-cli db:migrate:undo",
    "migrate:up:staging": "NODE_ENV=staging npx sequelize-cli db:migrate",
    "seed:up:dev": "NODE_ENV=development npx sequelize-cli db:seed:all",
    "seed:up:staging": "NODE_ENV=staging npx sequelize-cli db:seed:all",
    "seed:undo": "NODE_ENV=development npx sequelize-cli db:seed:undo:all",
    "import:users:dev": "node scripts/importUsers.js development",
    "import:users:staging": "node scripts/importUsers.js staging",
    "import:users:prod": "node scripts/importUsers.js production"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@oxedom/shared-shuk": "workspace:*",
    "@hookform/resolvers": "^5.1.0",
    "@next/third-parties": "15.5.2",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-popover": "^1.1.5",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.6",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-select": "^2.1.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.13",
    "@radix-ui/react-toggle": "^1.1.9",
    "@sentry/nextjs": "^10.10.0",
    "@tanstack/react-table": "^8.21.3",
    "@types/node": "^22.10.7",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "@yuvalkarif/gradient-blob": "^1.0.0",
    "canvas-confetti": "^1.9.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.0.0",
    "csv-parser": "^3.2.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.473.0",
    "motion": "^12.23.6",
    "next": "15.5.2",
    "next-auth": "^5.0.0-beta.17",
    "next-build-id": "^3.0.0",
    "next-intl": "^4.0.2",
    "next-themes": "^0.4.4",
    "perfect-debounce": "^2.0.0",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "qrcode.react": "^4.2.0",
    "react": "19.1.1",
    "react-day-picker": "8.10.1",
    "react-dom": "19.1.1",
    "react-hook-form": "^7.54.2",
    "react-icons": "^5.4.0",
    "recharts": "^2.15.0",
    "sequelize": "^6.37.5",
    "sequelize-typescript": "^2.1.6",
    "swiper": "^11.2.6",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.0.17",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^3.10.0",
    "@eslint-react/eslint-plugin": "^1.17.1",
    "@faker-js/faker": "^9.3.0",
    "@playwright/test": "^1.55.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/pg": "^8.11.10",
    "@types/sequelize": "^4.28.20",
    "autoprefixer": "^10.4.16",
    "dotenv": "^16.4.7",
    "eslint": "9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "intl-watcher": "^0.4.0",
    "postcss": "^8.4.32",
    "prettier": "^3.5.3",
    "tailwindcss": "^3.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "resolutions": {
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9"
  }
}
